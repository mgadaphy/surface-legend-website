# Inside the container only: plain HTTP on :80. HTTPS is handled by Caddy on the VPS host.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle {
		root * /srv
		# Hashed build files never change: cache them for a year.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@media path /images/* /favicon.png
		header @media Cache-Control "public, max-age=604800"
		# Client-side routes (wouter): unknown paths load the app.
		try_files {path} /index.html
		file_server
	}
}
