# Inside the container only: plain HTTP on :80. HTTPS is handled by Caddy on the VPS host.
{
	admin off
	auto_https off
	servers {
		# Requests come from the host's Caddy: keep the visitor's address it passes on (contact form rate limit).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# The admin, its data and the contact form live in the admin container.
	@admin path /admin /admin/* /cms-api /cms-api/* /api/* /_next/* /brand/* /sitemap.xml
	handle @admin {
		reverse_proxy admin:3000
	}

	handle {
		root * /srv
		# Hashed build files never change: cache them for a year.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@media path /images/* /favicon.png
		header @media Cache-Control "public, max-age=604800"
		# Client-side routes (wouter): unknown paths load the app.
		try_files {path} /index.html
		file_server
	}
}
